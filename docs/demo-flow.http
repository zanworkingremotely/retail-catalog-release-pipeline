@host = https://localhost:7140

### Preview the latest approved merchandising version version
GET {{host}}/api/product-rollouts/preview/latest

### Schedule the approved version using the fingerprint from the preview response
POST {{host}}/api/product-rollouts/schedule
Content-Type: application/json

{
  "merchandisingVersionId": "SS26-DROP-02",
  "scheduledFor": "2026-05-07T23:00:00Z",
  "requestedBy": "merchandising-admin@retail.com",
  "previewFingerprint": "replace-with-preview-fingerprint"
}

### Inspect scheduled, published, blocked, or failed rollouts
GET {{host}}/api/product-rollouts

### Execute due rollouts manually
POST {{host}}/api/product-rollouts/execute-due
